{
  "name": "pi-opendesign",
  "version": "1.0.0",
  "description": "Drive a local OpenDesign workspace from pi: one design tool, artifact links when runs finish.",
  "license": "MIT",
  "author": "Marco Ferretti",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opendesign",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcodellemarche/pi-opendesign.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
